# AWS / Cloud Storage Configuration
VITE_AWS_REGION=us-east-1

# S3 Bucket (Retrieved from Terraform State)
VITE_AWS_S3_BUCKET_NAME=SensaAI-pilot-content-311964231104

# Cognito (Retrieved from infra/client_info.json)
VITE_COGNITO_USER_POOL_ID=us-east-1_ldLKZ5Tp0
VITE_COGNITO_CLIENT_ID=5krssa43aq6gjaev84al0qp2te

# Identity Pool (Required for StorageManager to authenticate)
# NOT FOUND in Terraform/Infra. You must create this in Cognito Identity Pools console.
VITE_COGNITO_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# DynamoDB Table (Required for File Search/Indexing)
# NOT FOUND in Terraform. You must create this table manually (PK: id, String).
VITE_AWS_DYNAMODB_TABLE_NAME=SensaAI-pilot-results

# API Gateway Endpoint for Gym AI Lambda
VITE_GYM_AI_URL=https://c4kxjdukwj.execute-api.us-east-1.amazonaws.com

# Backend API URL (Express server for auth and other endpoints)
# For local development: http://localhost:3000/api/v1
# For production: Deploy backend to Elastic Beanstalk/ECS and set the URL here
# Example: http://SensaAI-backend-prod.us-east-1.elasticbeanstalk.com/api/v1
VITE_API_URL=http://localhost:3000/api/v1

# Optional: ElevenLabs API Key for Voice
VITE_ELEVENLABS_API_KEY=
