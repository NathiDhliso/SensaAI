# Backend Production Environment Variables
# Copy this file to .env.production and fill in your production values

# Server Configuration
PORT=3000
NODE_ENV=production

# AWS Configuration
AWS_REGION=us-east-1

# Cognito Configuration (Production Pool)
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-production-client-id
COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com

# CORS Configuration (CRITICAL: Set to your production domain)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# DynamoDB Tables (Production)
CONCEPTS_TABLE=sensapbl-concepts-prod
JOBS_TABLE=sensapbl-jobs-prod

# Lambda Functions (Production)
GENERATE_LAMBDA=sensapbl-generate-concepts-prod

# Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6

# CLM Configuration (Production)
CLM_AUDITS_TABLE=sensapbl-clm-audits-prod
CLM_VERSIONS_TABLE=sensapbl-clm-versions-prod
CLM_CHANGELOG_TABLE=sensapbl-clm-changelog-prod
CLM_ORCHESTRATOR_FUNCTION=sensapbl-clm-orchestrator-prod
CLM_UPDATE_EXECUTOR_FUNCTION=sensapbl-clm-update-executor-prod

# Security (NEVER commit these values)
# JWT_SECRET=your-jwt-secret-here
# API_KEY=your-api-key-here

# Optional: Error Tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
