# Production Environment Variables
# Copy this file to .env.production and fill in your production values

# AWS Region
VITE_AWS_REGION=us-east-1

# API Endpoints (Replace with your production API Gateway URL)
VITE_API_URL=https://your-api-gateway-url.execute-api.us-east-1.amazonaws.com
VITE_API_ENDPOINT=https://your-api-gateway-url.execute-api.us-east-1.amazonaws.com
VITE_GYM_AI_URL=https://your-api-gateway-url.execute-api.us-east-1.amazonaws.com

# Cognito Configuration (Replace with your production Cognito pool)
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=your-client-id
VITE_COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=https://yourdomain.com/auth/callback
VITE_COGNITO_IDENTITY_POOL_ID=us-east-1:your-identity-pool-id

# AWS Resources (Replace with your production resources)
VITE_AWS_S3_BUCKET_NAME=your-production-bucket
VITE_AWS_DYNAMODB_TABLE_NAME=your-production-table

# Feature Flags
VITE_UNIFIED_FLOW_ENABLED=true

# Optional: Error Tracking
# VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
