# ==============================================================================
# SensaPBL Production Environment (.env.production)
# Environment: prod
# Deploy via: infra/terraform/environments/prod/
# ==============================================================================

# AWS Region
VITE_AWS_REGION=us-east-1

# API Gateway (from terraform output: api_endpoint)
VITE_API_URL=
VITE_API_ENDPOINT=
VITE_GYM_AI_URL=

# Cognito Auth (from terraform output)
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=sensapbl-prod.auth.us-east-1.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=https://sensaai.co.za/auth/callback

# S3 Content Bucket (from terraform output: s3_content_bucket)
VITE_AWS_S3_BUCKET_NAME=

# DynamoDB (from terraform output: dynamodb_concepts_table)
VITE_AWS_DYNAMODB_TABLE_NAME=

# Cognito Identity Pool (create manually in AWS Console if needed)
VITE_COGNITO_IDENTITY_POOL_ID=

# Optional: ElevenLabs API Key for Voice
VITE_ELEVENLABS_API_KEY=
