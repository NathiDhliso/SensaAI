# Secrets Configuration Template
# Copy this file to secrets.tfvars and fill in your actual credentials
# NEVER commit secrets.tfvars to Git!

# Cross-account Bedrock IAM role ARN (alternative to static creds)
cross_account_role_arn = ""

# Bedrock account static credentials (account 693582801685)
# These are used by Lambdas to call Bedrock in the Bedrock account
bedrock_access_key_id     = "AKIA..."
bedrock_secret_access_key = "your-secret-key-here"

# Usage:
# terraform apply -var-file="terraform.tfvars" -var-file="secrets.tfvars"
